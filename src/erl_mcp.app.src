        mcp_session_manager,
        mcp_tool_registry
    ]},
    {mod, {mcp_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
