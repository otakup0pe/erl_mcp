{application, erl_mcp, [
    {description, "Erlang implementation of the Model Context Protocol (MCP)"},
    {vsn, "0.1.0"},
    {registered, [
        erl_mcp_server_session_manager,
        erl_mcp_server_tool_registry
    ]},
    {mod, {erl_mcp_app, []}},
    {applications, [
        kernel,
        stdlib,
        inets,
        cowboy
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/otakup0pe/erl_mcp"}]}
]}.
