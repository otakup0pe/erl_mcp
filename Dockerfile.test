FROM erlang:27-slim

RUN apt-get update \
    && apt-get install -y make git openssh-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Pre-populate system-wide known_hosts. erl_mcp's deps are public
# (cowboy from Hex), but the SSH plumbing is included for symmetry
# with klotho and moirai and for any future SSH dep additions.
RUN mkdir -p /etc/ssh \
    && ssh-keyscan github.com >> /etc/ssh/ssh_known_hosts 2>/dev/null \
    && chmod 644 /etc/ssh/ssh_known_hosts

# Install rebar3 from source.
RUN git clone https://github.com/erlang/rebar3.git /tmp/rebar3 \
    && cd /tmp/rebar3 && ./bootstrap \
    && install -m 755 /tmp/rebar3/rebar3 /usr/local/bin/rebar3 \
    && rm -rf /tmp/rebar3

CMD ["make", "local-test"]
