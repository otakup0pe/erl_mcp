#!/bin/sh
# Scan _checkouts/ for symlinks, emit docker-compose volume overrides.

CHECKOUTS_DIR="${1:-_checkouts}"
SERVICES="test"
VOLUMES=""

for entry in "$CHECKOUTS_DIR"/*; do
    [ -L "$entry" ] || continue
    real_path="$(readlink -f "$entry" 2>/dev/null)" || true
    if [ -z "$real_path" ] || [ ! -d "$real_path" ]; then
        printf "WARNING: skipping broken symlink %s\n" "$entry" >&2
        continue
    fi
    VOLUMES="${VOLUMES}      - ${real_path}:${real_path}:ro\n"
done

if [ -z "$VOLUMES" ]; then
    printf "# no symlinked checkouts found\nservices: {}\n"
else
    printf "services:\n"
    for svc in $SERVICES; do
        printf "  %s:\n    volumes:\n" "$svc"
        printf "%b" "$VOLUMES"
    done
fi
